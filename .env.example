# Variables de entorno para desarrollo y despliegue

# VITE_API_BASE: Endpoint de API serverless (Vercel)
# En Vercel: Deja vacío "" o usa "https://<project>.vercel.app"
# La app detectará automáticamente /api/mega-direct-link
# En desarrollo local: VITE_API_BASE=http://localhost:5173
# En GitHub Pages: Deja vacío para usar API externa fallback
VITE_API_BASE=
